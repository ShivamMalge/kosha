# Python
__pycache__/
*.py[cod]

# Local environment pointers - machine-specific, not shareable
.harness_path

# Raw per-run stream captures. Regenerated by every batch and bulky
# (~110 files per eval set). They exist to diagnose a failing batch in the
# moment; once a batch is written up, the diagnostic lines are quoted in the
# results doc and the bulk is not worth versioning.
# NOTE: archived void batches under eval/results/void_* ARE tracked, because
# the evidence of *why* a batch was void is the whole point of keeping it.
eval/results/raw_*/

# Throwaway projects created by the G2 runner
kosha_g2_*/
